t='{"validation":{}}' aria-describedby="login-phone-error"> <input name="login[username]" value=""  autocomplete="off" id="email" type="email" class="input-text  " title="&#x0627;&#x0644;&#x0628;&#x0631;&#x064A;&#x062F;&#x20;&#x0627;&#x0644;&#x0627;&#x0644;&#x0643;&#x062A;&#x0631;&#x0648;&#x0646;&#x064A;" data-mage-init='{"mage/trim-input":{},"validation":{}}' data-validate="{required:true, 'validate-email':true }"> <div class="profile-notice-phone hide"><span>الرجاء إضافة رقم الهاتف بدون 0 ورمز البلد.</span></div></div></div> <input type='hidden' name='login[otp]' class='verifiedotp' value='0'/><input type='hidden' class='sendUrlLogin' value='https://alaseel.com/smsprofile/otp/send/'/><input type='hidden' class='verifyUrlLogin' value='https://alaseel.com/smsprofile/otp/verify/'/><input type='hidden' class='logintype' value='login_both'/> <div class="field action_otp hide"><button class="send_otp_login action primary" style="display: none;margin-top: 15px;" type="button">ارسال رمز التاكيد</button> <span class="otp_generatenote">&nbsp;</span></div>   <div class="field password required login_both"  ><label for="pass" class="label"><span>كلمة السر</span></label> <div class="control"><input name="login[password]" type="password"  autocomplete="off" class="input-text" id="pass" title="&#x0643;&#x0644;&#x0645;&#x0629;&#x20;&#x0627;&#x0644;&#x0633;&#x0631;" data-validate="{required:true}" ></div></div>  <div class="actions-toolbar padding-top10"><div class="primary"><button type="submit" class="action login primary btn btn-secondary" name="send" id="send2"><span>تسجيل الدخول</span></button></div><div class="secondary"><a class="action remind" href="https://alaseel.com/customer/account/forgotpassword/"><span>هل نسيت كلمة المرور؟</span></a></div></div></fieldset></form></div></div> <script>
    require(['jquery','mage/validation'], function($) {
        var dataForm = $('#account-popup #login-form');
        var ignore = null;

        dataForm.mage('validation', {
            ignore: ignore ? ':hidden:not(' + ignore + ')' : ':hidden'
        }).find('input:text').attr('autocomplete', 'off');


        var classValidate = 'profile-validate-mobile-mail maximum-length-12 minimum-length-9';
        var isValidate = false;

        $(document).ready(function() {
            var only_use_phone = "no";
            if (only_use_phone == 'yes') {
                setTimeout(() => {
                    $('#account-popup #login-form .mobile_otp').trigger('click');
                }, 1000);
            }
            $(document).on('click','#account-popup #login-form .email_login', function(event) {
                event.preventDefault();
                $('#account-popup #login-form').find('.login_type').removeClass('active');
                $('#account-popup #login-form #login-phone-error').remove();
                $(this).addClass('active');
                if(!$('#account-popup #login-form .password.password').hasClass('required')){
                    $('#account-popup #login-form .field.password').addClass('required').show().removeClass('hide');
                    $('#account-popup #login-form [name="login[username]"').removeClass(classValidate);
                    $('#account-popup #login-form #email').attr('type', "email");
                    $('#account-popup #login-form #email').attr('data-validate', "{required:false,'validate-email':true}");
                    $('#account-popup #login-form .action_otp').addClass('hide');
                    $('#account-popup #login-form #phone-code').addClass('hide');
                    $('#account-popup #login-form #login-phone').addClass('hide');
                    $('#account-popup #login-form .verifiedotp').val(0);
                }
            });

            $(document).on('click','#account-popup #login-form .mobile_otp', function(event) {
                event.preventDefault();
                $('#account-popup #login-form').find('.login_type').removeClass('active');
                $(this).addClass('active');
                if($('#account-popup #login-form .login_both.password').hasClass('required')){
                    $('#account-popup #login-form #email').attr('type', "hidden");
                    $('#account-popup #login-form .field.password').removeClass('required').hide().addClass('hide');
                    $('#account-popup #login-form #email').addClass(classValidate);
                    $('#account-popup #login-form #email').attr('data-validate', "{required:false}");
                    $('#account-popup #login-form .field.password #pass').attr('data-validate', '{required:false}');
                    $('#account-popup #login-form .action_otp').removeClass('hide');
                    $('#account-popup #login-form #phone-code').removeClass('hide');
                    $('#account-popup #login-form #login-phone').removeClass('hide');
                    $('#account-popup #login-form .verifiedotp').val(1);
                }
            });

            $(document).on('change','#account-popup #login-form #login-phone',function(event) {
                event.preventDefault();

                if(dataForm.validation('isValid')){
                    var mobilefone = $('#account-popup #login-form #phone-code').val() + $(this).val();
                    $('#account-popup #login-form #email').val(mobilefone.replace('+', '')).trigger('change').blur();
                }
                else {
                    $('#account-popup #login-form #email').val("").trigger('change').blur();
                }
            });

            /* code for otp at login page  starts here*/
            $(document).on("blur", "#account-popup #login-form .login-phone", function() {
                if ($(this).val() != '') {
                    $(document).find('.resendlink').hide();
                    if (!$.isNumeric($(this).val())) {
                        $(document).find('#account-popup #login-form .send_otp_login').hide();
                        $(document).find('#account-popup #login-form .password').show();
                        $('#account-popup #login-form .actions-toolbar #send2').attr("disabled", false);
                    } else {
                        $(document).find('.send_otp_login').show();
                        if ($(document).find('#account-popup #login-form .logintype').val() != 'login_both') {
                            $(document).find('#account-popup #login-form .password').hide();
                        } else {
                            $(document).find('#account-popup #login-form .password').show();
                        }
                        $('#account-popup #login-form .actions-toolbar #send2').attr("disabled", true);
                    }
                }
            });

            $(document).on("click", "#account-popup #login-form .send_otp_login", function() {
                var sendotpurllogin = $('#account-popup #login-form .sendUrlLogin').val();
                var mobile = $("#account-popup #login-form #email").val();
                var btnthis = $(this);
                if($(document).find("#account-popup #login-form .smserror").length > 0 ) {
                    $(document).find("#account-popup #login-form .smserror").html('');
                }

                if($('#account-popup #login-form #email').length > 0) {
                    var isValidate = false;
                    if ($('#account-popup #login-form #email').validation('isValid')) {
                        isValidate = true;
                    }
                }
                var isResend = 0;

                if (isValidate) {
                    $.ajax({
                        showLoader: true,
                        url: sendotpurllogin,
                        method: "POST",
                        data: {
                            mobile: mobile,
                            eventType: 'customer_login_otp',
                            resend: isResend,
                        },
                        dataType: "json"
                    }).done(function(response) {
                        btnthis.trigger('blur');
                        if (response.Success === 'success') {
                            $(document).find('.otp_generatenote').html('تحقق من OTP');
                            $(document).find('.otp_generatenote').delay(5000).fadeOut(800);
                            if($(".resendlink").length == 0 && $(".field-name-otp").length == 0) {
                                $(".otp_generatenote").after('<div class="resendlink"><a href="javascript:void(0);" class="resendotp" >إعادة إرسال OTP</a></div><div class="field fieldset field-name-otp required"><label class="label" for="otp"><span>الرجاء إدخال رمز التحقق هنا</span></label>  <div class="control"><input id="otp" name="otp" value="" title="otp" class="input-text required-entry" data-validate="{required:true}" autocomplete="off" aria-required="true" type="text" novalidate="novalidate"><button style="display: block;margin-top: 10px;" class="verif_otp_login action primary" type="button">تحقق من OTP</button></div></div><span class="otp_text"></span> ');
                                $("#account-popup #login-form .send_otp_login").hide();
                            }
                        } else {
                            if($(".smserror").length == 0 ) {
                                $(".send_otp_login").after('<p class="smserror">'+response.Success+'</p>');
                            }
                            if($(document).find(".smserror").length > 0 ) {
                                $(document).find(".smserror").html(response.Success);
                            }
                        }

                    });
                }
            });

            $(document).on("click", "#account-popup #login-form .verif_otp_login", function() {
                var sendotpurlLogin = $('#account-popup #login-form .verifyUrlLogin').val();
                var btnthis = $(this);
                if ( $('#account-popup #login-form #otp').val() != '' ) {
                    $('#account-popup #login-form .otp_text').html('');
                    var mobile = $("#account-popup #login-form #email").val();
                    var otp = $("#account-popup #login-form #otp").val();
                    console.log(mobile +' ____ '+ otp);
                    $.ajax({
                        showLoader: true,
                        url: sendotpurlLogin,
                        method: "POST",
                        data: {
                            otp: otp,
                            mobile: mobile
                        },
                        dataType: "json"
                    }).done(function(response) {
                        btnthis.trigger('blur');
                        if (response) {
                            $(document).find("#account-popup #login-form .otp_generatenote").html('');
                            $(document).find('#account-popup #login-form .otp_generatenote').fadeIn();
                            if(response.message == 'Verified'){
                                $('#account-popup #login-form .otp_text').html('تم التحقق');
                            }else{
                                $('#account-popup #login-form .otp_text').html(response.message);
                            }

                            if (response.message == 'Verified') {
                                $('#account-popup #login-form .otp_text').css('color','green');
                                $('#account-popup #login-form .verifiedotp').val(1);
                                $('#account-popup #login-form .send_otp_login').hide();
                                $('#account-popup #login-form .resendlink').hide();
                                $('#account-popup #login-form .field-name-otp').hide();
                                $('#account-popup #login-form .actions-toolbar #send2').attr("disabled", false);
                                $('#account-popup #login-form .actions-toolbar #send2').trigger('click');
                            } else {
                                $('#account-popup #login-form .otp_text').css('color','red');
                                $('#account-popup #login-form .verifiedotp').val(0);
                            }
                        }
                    });
                } else {
                    alert('Please enter OTP');
                }
            });
            /* code for otp at login page ends here*/

            /* code for resend otp start here*/

            $(document).on("click","#account-popup #login-form .resendotp", function(){
                var buttonDisable = $(document).find('#account-popup #login-form .actions-toolbar button.action.submit.primary').is(":disabled");
                if ($('#account-popup #login-form #email').length > 0) {
                    buttonDisable = $(document).find('#account-popup #login-form .actions-toolbar #send2').is(":disabled");
                }
                var sendotpurl = $('#account-popup #login-form .sendUrl').val();
                var event = 'customer_signup_otp';
                var mobile = $("#account-popup #login-form #email").val();
                var isResend = 1;
                var btnthis = $(this);
                if ($('#account-popup #login-form #email').length > 0) {
                    sendotpurl = $('#account-popup #login-form .sendUrlLogin').val();
                    mobile = $("#account-popup #login-form #email").val();
                    event = 'customer_login_otp';
                }

                if (buttonDisable) {
                    $.ajax({
                        showLoader: true,
                        url: sendotpurl,
                        method: "POST",
                        data: {
                            mobile : mobile,
                            eventType : event,
                            resend : isResend,
                        },
                        dataType: "json"
                      }).done(function( response ){
                        btnthis.trigger('blur');
                        if(response.Success === 'success' ){
                            $(document).find('#account-popup #login-form .otp_generatenote').fadeIn();
                            $(document).find("#account-popup #login-form .otp_generatenote").html('تم إرسال OTP بنجاح.');
                            $(document).find('#account-popup #login-form .otp_generatenote').delay(5000).fadeOut(800);
                        }
                        else {
                            $(document).find('#account-popup #login-form .otp_generatenote').fadeIn();
                            $(document).find("#account-popup #login-form .otp_generatenote").html('غير قادر على إرسال الرسائل القصيرة');
                            $(document).find('#account-popup #login-form .otp_generatenote').delay(5000).fadeOut(800);
                        }
                    });
                }
            });
        });
    });</script> </div><div class="info-summary-bottom"><div class="md-content"> <p class="secondary"><span class="create-account-question">عميل جديد ؟</span> <a class="create-account-link" href="https://alaseel.com/customer/account/create/">ابدأ هنا</a></p></div></div></div><div class="acount-menu"><ul class="account-menu-items items">  <li class="nav item"><a  href="https://alaseel.com/customer/account/" class="account" > حسابي </a></li>  <!-- link -->   <li class="link wishlist" data-bind="scope: 'wishlist'"><a class="cdz-top-link" href="https://alaseel.com/wishlist/">المفضلة <!-- ko if: wishlist().counter --> (<span data-bind="text: wishlist().counter" class="counter qty"></span>) <!-- /ko --></a></li>   <script type="text/x-magento-init">
