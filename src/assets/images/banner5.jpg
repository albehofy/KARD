    function loadCSSLinks() {
        require(['jquery/jquery.cookie'], function() {
            var styles = ["https:\/\/static.cdn-alaseel.com\/pub\/static\/frontend\/Codazon\/unlimited_fashion_megastore\/ar_SA\/mage\/calendar.min.css","https:\/\/static.cdn-alaseel.com\/pub\/static\/frontend\/Codazon\/unlimited_fashion_megastore\/ar_SA\/css\/animate\/animate.min.css"];
