		"Magento_Ui/js/core/app": {"components":{"minicartpro_content":{"config":{"itemRenderer":{"default":"defaultRenderer","simple":"defaultRenderer","virtual":"defaultRenderer"},"template":"Codazon_ShoppingCartPro\/minicart\/content"},"children":{"item.renderer":{"component":"uiComponent","config":{"displayArea":"defaultRenderer","template":"Codazon_ShoppingCartPro\/minicart\/item\/default"},"children":{"item.image":{"component":"Magento_Catalog\/js\/view\/image","config":{"template":"Magento_Catalog\/product\/image","displayArea":"itemImage"}},"checkout.cart.item.price.sidebar":{"component":"uiComponent","config":{"template":"Magento_Checkout\/minicart\/item\/price","displayArea":"priceSidebar"}}}},"subtotal.container":{"children":{"subtotal":{"children":{"subtotal.totals":{"component":"Magento_Checkout\/js\/view\/checkout\/minicart\/subtotal\/totals","config":{"template":"Magento_Checkout\/minicart\/subtotal\/totals"}}},"component":"uiComponent","config":{"template":"Magento_Checkout\/minicart\/subtotal"}}},"component":"uiComponent","config":{"displayArea":"subtotalContainer"}},"extra_info":{"component":"uiComponent","config":{"displayArea":"extraInfo"}},"promotion":{"component":"uiComponent","config":{"displayArea":"promotion"}}},"component":"Codazon_ShoppingCartPro\/js\/minicart"}},"types":[]}	}
}</script>    <div class="md-sidenav-left cdz-sidebar" data-sidebarid="left"> <div class="utilies-sections"> </div></div>  <div class="md-sidenav-right cdz-sidebar" data-sidebarid="right"> <div class="utilies-sections">     <div class="utilies-section nice-scroll active utilies-wishlist" id="utilies-wishlist" >  <div class="wislist-sidebar-content"> <div class="account-info-summary mini-list no-login"><div class="block-top"><div class="block-title"><strong>الرجاء تسجيل الدخول أولا</strong></div></div><div class="info-summary-top 123"><p class="desc">يجب عليك تسجيل الدخول لإدارة قائمة المفضلة الخاصة بك.</p>  <!-- login style default --><div class="block-customer-login"><div class="block-content" aria-labelledby="block-customer-login-heading"> <form class="form form-login" action="https://alaseel.com/customer/account/loginPost/" method="post" id="login-form" data-mage-init='{"validation":{}}'><input name="form_key" type="hidden" value="jTlMlcrY67TKBarZ" /> <fieldset class="fieldset login" data-hasrequired="* حقول مطلوبة"><div class="field email required"> <label class="label" for="wl-email"><span><a href="#" class="login_type email_login active">البريد الالكتروني</a></span><span><a href="#" class="login_type mobile_otp">هاتف</a></span></label>  <div class="control" style="margin-top: 7px;">  <select class="phone-code hide" name="phone_code" data-role="phone-code" id="wl-phone-code"> <option value="+966">+966</option></select> <input type="number" class="input-text minimum-length-9 maximum-length-10 hide" id="wl-login-phone" name="phone_number" placeholder="5xxxxxxxx" inputmode="numeric" data-validate="{required:true, 'validate-length':true,'required-number':true}" data-mage-init='{"validation":{}}' aria-describedby="login-phone-error" style="width: calc(~'100% - 95px');"> <input name="login[username]" value=""  autocomplete="off" id="wl-email" type="email" class="input-text  " title="&#x0627;&#x0644;&#x0628;&#x0631;&#x064A;&#x062F;&#x20;&#x0627;&#x0644;&#x0627;&#x0644;&#x0643;&#x062A;&#x0631;&#x0648;&#x0646;&#x064A;" data-mage-init='{"mage/trim-input":{},"validation":{}}' data-validate="{required:true, 'validate-email':true }"> <div class="profile-notice-phone hide"><span>الرجاء إضافة رقم الهاتف بدون 0 ورمز البلد.</span></div></div></div> <input type='hidden' name='login[otp]' class='verifiedotp' value='0'/><input type='hidden' class='sendUrlLogin' value='https://alaseel.com/smsprofile/otp/send/'/><input type='hidden' class='verifyUrlLogin' value='https://alaseel.com/smsprofile/otp/verify/'/><input type='hidden' class='logintype' value='login_both'/> <div class="field action_otp hide"><button class="send_otp_login action primary" style="display: none;margin-top: 15px;" type="button">ارسال رمز التاكيد</button> <span class="otp_generatenote">&nbsp;</span></div>   <div class="field password required login_both" "  ><label for="pass" class="label"><span>كلمة السر</span></label> <div class="control"><input name="login[password]" type="password"  autocomplete="off" class="input-text" id="pass" title="&#x0643;&#x0644;&#x0645;&#x0629;&#x20;&#x0627;&#x0644;&#x0633;&#x0631;" data-validate="{required:true}" ></div></div>  <div class="actions-toolbar padding-top10"><div class="primary"><button type="submit" class="action login primary btn btn-secondary" name="send" id="send2"><span>تسجيل الدخول</span></button></div><div class="secondary"><a class="action remind" href="https://alaseel.com/customer/account/forgotpassword/"><span>هل نسيت كلمة المرور؟</span></a></div></div></fieldset></form></div></div> <script>
     require(['jquery','mage/validation'], function($) {
        var dataForm = $('.md-sidenav-right #utilies-wishlist #login-form');
        var ignore = null;
        var classValidate = 'profile-validate-mobile-mail maximum-length-12 minimum-length-9';
        var isValidate = false;

        dataForm.mage('validation', {
            ignore: ignore ? ':hidden:not(' + ignore + ')' : ':hidden'
        }).find('input:text').attr('autocomplete', 'off');

        $(document).ready(function() {
            $(document).on('click','.md-sidenav-right #utilies-wishlist #login-form  .email_login', function(event) {
                event.preventDefault();
                $('.md-sidenav-right #utilies-wishlist #login-form').find('.login_type').removeClass('active');
                $(this).addClass('active');
                if(!$('.md-sidenav-right #utilies-wishlist #login-form  .password.password').hasClass('required')){
                    $('.md-sidenav-right #utilies-wishlist #login-form  .field.password').addClass('required').show().removeClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  [name="login[username]"').removeClass(classValidate);
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').attr('type', "email");
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').attr('data-validate', "{required:false,'validate-email':true}");
                    $('.md-sidenav-right #utilies-wishlist #login-form  .action_otp').addClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-phone-code').addClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-login-phone').addClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  .verifiedotp').val(0);
                }
            });

            $(document).on('click','.md-sidenav-right #utilies-wishlist #login-form  .mobile_otp', function(event) {
                event.preventDefault();
                $('.md-sidenav-right #utilies-wishlist #login-form').find('.login_type').removeClass('active');
                $(this).addClass('active');
                if($('.md-sidenav-right #utilies-wishlist #login-form  .login_both.password').hasClass('required')){
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').attr('type', "hidden");
                    $('.md-sidenav-right #utilies-wishlist #login-form  .field.password').removeClass('required').hide().addClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').addClass(classValidate);
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').attr('data-validate', "{required:false}");
                    $('.md-sidenav-right #utilies-wishlist #login-form  .field.password #pass').attr('data-validate', '{required:false}');
                    $('.md-sidenav-right #utilies-wishlist #login-form  .action_otp').removeClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-phone-code').removeClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-login-phone').removeClass('hide');
                    $('.md-sidenav-right #utilies-wishlist #login-form  .verifiedotp').val(1);
                }
            });

            $(document).on('change','.md-sidenav-right #wl-login-phone',function(event) {
                event.preventDefault();

                if(dataForm.validation('isValid')){
                    var mobilefone = $('.md-sidenav-right #utilies-wishlist #login-form  #wl-phone-code').val() + $(this).val();
                    $('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').val(mobilefone.replace('+', '')).trigger('change').blur();
                }
            });

            /* code for otp at login page  starts here*/
            $(document).on("blur", ".md-sidenav-right #utilies-wishlist #login-form  #wl-email", function() {
                if ($(this).val() != '') {
                    $(document).find('.resendlink').hide();
                    if (!$.isNumeric($(this).val())) {
                        $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .send_otp_login').hide();
                        $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .password').show();
                        $('.md-sidenav-right #utilies-wishlist #login-form  .actions-toolbar #send2').attr("disabled", false);
                    } else {
                        $(document).find('.send_otp_login').show();
                        if ($(document).find('.md-sidenav-right #utilies-wishlist #login-form  .logintype').val() != 'login_both') {
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .password').hide();
                        } else {
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .password').show();
                        }
                        $('.md-sidenav-right #utilies-wishlist #login-form  .actions-toolbar #send2').attr("disabled", true);
                    }
                }    
            });
            
            $(document).on("click", ".md-sidenav-right #utilies-wishlist #login-form  .send_otp_login", function() {
                var sendotpurllogin = $('.md-sidenav-right #utilies-wishlist #login-form  .sendUrlLogin').val();
                var mobile = $(".md-sidenav-right #utilies-wishlist #login-form  #wl-email").val();
                var btnthis = $(this);
                if($(document).find(".md-sidenav-right #utilies-wishlist #login-form  .smserror").length > 0 ) {
                    $(document).find(".md-sidenav-right #utilies-wishlist #login-form  .smserror").html('');
                }

                if($('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').length > 0) {
                    var isValidate = false;
                    if ($('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').validation('isValid')) {
                        isValidate = true;
                    } 
                }    
     
                var isResend = 0;

                if (isValidate) {
                    $.ajax({
                        showLoader: true,
                        url: sendotpurllogin,
                        method: "POST",
                        data: {
                            mobile: mobile,
                            eventType: 'customer_login_otp',
                            resend: isResend,
                        },
                        dataType: "json"
                    }).done(function(response) {
                        btnthis.trigger('blur');
                        if (response.Success === 'success') {
                            $(document).find('.otp_generatenote').html('تحقق من OTP');
                            $(document).find('.otp_generatenote').delay(5000).fadeOut(800);
                            if($(".resendlink").length == 0 && $(".field-name-otp").length == 0) {
                                $(".otp_generatenote").after('<div class="resendlink"><a href="javascript:void(0);" class="resendotp" >إعادة إرسال OTP</a></div><div class="field fieldset field-name-otp required"><label class="label" for="otp"><span>الرجاء إدخال رمز التحقق هنا</span></label>  <div class="control"><input id="otp" name="otp" value="" title="otp" class="input-text required-entry" data-validate="{required:true}" autocomplete="off" aria-required="true" type="text" novalidate="novalidate"><button style="display: block;margin-top: 10px;" class="verif_otp_login action primary" type="button">تحقق من OTP</button></div></div><span class="otp_text"></span> ');
                            }    
                        } else {
                            if($(".smserror").length == 0 ) {
                                $(".send_otp_login").after('<p class="smserror">'+response.Success+'</p>');
                            }
                            if($(document).find(".smserror").length > 0 ) {
                                $(document).find(".smserror").html(response.Success);
                            }
                        }

                    });
                } 
            });

            $(document).on("click", ".md-sidenav-right #utilies-wishlist #login-form  .verif_otp_login", function() {
                var sendotpurlLogin = $('.md-sidenav-right #utilies-wishlist #login-form  .verifyUrlLogin').val();
                var btnthis = $(this);
                if ( $('.md-sidenav-right #utilies-wishlist #login-form  #otp').val() != '' ) {
                    $('.md-sidenav-right #utilies-wishlist #login-form  .otp_text').html('');
                    var mobile = $(".md-sidenav-right #utilies-wishlist #login-form  #wl-email").val();
                    var otp = $(".md-sidenav-right #utilies-wishlist #login-form  #otp").val();
                    
                    $.ajax({
                        showLoader: true,
                        url: sendotpurlLogin,
                        method: "POST",
                        data: {
                            otp: otp,
                            mobile: mobile
                        },
                        dataType: "json"
                    }).done(function(response) {
                        btnthis.trigger('blur');
                        if (response) {
                            $(document).find(".md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote").html('');
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote').fadeIn();
                            if(response.message == 'Verified'){
                                $('.md-sidenav-right #utilies-wishlist #login-form  .otp_text').html('تم التحقق');
                            }else{
                                $('.md-sidenav-right #utilies-wishlist #login-form  .otp_text').html(response.message);
                            }
                            
                            if (response.message == 'Verified') {
                                $('.md-sidenav-right #utilies-wishlist #login-form  .otp_text').css('color','green');
                                $('.md-sidenav-right #utilies-wishlist #login-form  .verifiedotp').val(1);
                                $('.md-sidenav-right #utilies-wishlist #login-form  .send_otp_login').hide();
                                $('.md-sidenav-right #utilies-wishlist #login-form  .resendlink').hide();
                                $('.md-sidenav-right #utilies-wishlist #login-form  .field-name-otp').hide();
                                $('.md-sidenav-right #utilies-wishlist #login-form  .actions-toolbar #send2').attr("disabled", false);
                            } else {
                                $('.md-sidenav-right #utilies-wishlist #login-form  .otp_text').css('color','red');
                                $('.md-sidenav-right #utilies-wishlist #login-form  .verifiedotp').val(0);
                            }
                        }
                    });
                } else {
                    alert('Please enter OTP');
                }
            });
            /* code for otp at login page ends here*/

            /* code for resend otp start here*/ 

            $(document).on("click",".md-sidenav-right #utilies-wishlist #login-form  .resendotp", function(){
                var buttonDisable = $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .actions-toolbar button.action.submit.primary').is(":disabled");
                if ($('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').length > 0) {
                    buttonDisable = $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .actions-toolbar #send2').is(":disabled");
                }
                var sendotpurl = $('.md-sidenav-right #utilies-wishlist #login-form  .sendUrl').val();
                var event = 'customer_signup_otp';
                var mobile = $(".md-sidenav-right #utilies-wishlist #login-form  #wl-email").val();
                var isResend = 1;
                var btnthis = $(this);
                if ($('.md-sidenav-right #utilies-wishlist #login-form  #wl-email').length > 0) {
                    sendotpurl = $('.md-sidenav-right #utilies-wishlist #login-form  .sendUrlLogin').val();
                    mobile = $(".md-sidenav-right #utilies-wishlist #login-form  #wl-email").val();
                    event = 'customer_login_otp';
                }
                
                if (buttonDisable) {
                    $.ajax({
                        showLoader: true,
                        url: sendotpurl,
                        method: "POST",
                        data: {
                            mobile : mobile,
                            eventType : event,
                            resend : isResend,
                        },
                        dataType: "json"
                      }).done(function( response ){
                        btnthis.trigger('blur');
                        if(response.Success === 'success' ){
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote').fadeIn();   
                            $(document).find(".md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote").html('تم إرسال OTP بنجاح.');
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote').delay(5000).fadeOut(800);
                        }else {
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote').fadeIn();
                            $(document).find(".md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote").html('غير قادر على إرسال الرسائل القصيرة');
                            $(document).find('.md-sidenav-right #utilies-wishlist #login-form  .otp_generatenote').delay(5000).fadeOut(800);                            
                        }
                    });
                }      
            });
        });
    });</script></div><div class="info-summary-bottom"><div class="md-content"><p class="secondary"><span class="create-account-question">عميل جديد ؟</span> <a class="create-account-link" href="">ابدأ هنا</a></p></div></div></div></div></div>   <div class="utilies-section nice-scroll  utilies-minicart" id="utilies-minicart" > <div data-block="minicart" id="minicart-list"><div class="block block-minicart empty"><button class="action-close" data-role="cdz-close-sidebar" type="button"><span>X</span></button> <div id="minicart-content-wrapper" data-bind="scope: 'minicart_content'"><!-- ko template: getTemplate() --><!-- /ko --></div></div></div><script type="text/javascript">
