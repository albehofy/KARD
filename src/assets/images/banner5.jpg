<style>
.product-list-style-02 .product.product-item {overflow:hidden}
.cms-index-index .container-fluid.space-lg  .row{margin-left:0;margin-right:0} 
.page-products.catalogsearch-result-index .product-item-info {overflow: hidden;}
.catalog-product-view .swatch-input {
top:-1000000px !important;
left:auto !important;
}
.page-footer .ddict_btn {
display:none;
}
.hidden {display: none !important;}
.page-header #top-wishlist:before {
border-radius: unset !important;
}
@media screen and (max-width: 767px) {
.container-fluid.space-lg  .row{margin-left:0;margin-right:0}
.container-fluid.space-lg .row .col-sm-24 {padding-left:0;padding-right:0}
.footer-bottom .bottom-vat {
display: block !important;
}
.footer-bottom .bottom-vat p {
display: inline-block !important;
}
#maincontent .container-fluid {
    padding: unset;
}
#maincontent .container-fluid .container{
    padding: unset;
}
#shopping-cart-table .col.subtotal:before {
		content: 'إجمالي الأصناف شامل الضريبة';
	}
#product-options-wrapper .swatch-input.super-attribute-select{
display:none;
}

}
#cdz-minicart-popup #minicartpro .product-item span.product-image-container{min-width: 75px;}
@media screen and (min-width: 768px){
body.rtl-layout #cdz-minicart-popup #minicartpro .product-item span.product-image-container .product-image-wrapper{
    padding-bottom:0 !important;
}
}

.cdz-product .products-grid .flex-grid .amasty-label-container {
    min-height: 100px;
}
.cdz-product .products-grid .flex-grid .amasty-label-container .amasty-label-image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
}
@media only screen and (max-width: 767px) {

    div#tabbyPromo div span {
        display: block !important;
    }
}
.product-view-style-03.rtl-layout .product-right {
    display: flex;
    flex-direction: column;
}
.product-view-style-03.rtl-layout .product-right .product-social-links {
    order: 2;
    margin-bottom: unset !important;
}
.product-view-style-03.rtl-layout .product-right div#tamara-product-widget {
    order: 1;
}
.product-view-style-03.rtl-layout .product-right .product.attribute.overview {
    order: 3;
}
.product-view-style-03.rtl-layout .product-right .product.pricing {
    order: 4;
    margin-top: unset !important;
}
.product-view-style-03.rtl-layout .product-right .product-static-text {
    display: none;
}
</style>

